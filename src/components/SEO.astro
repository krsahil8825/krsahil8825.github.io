---
import { SITE } from "../config/site";
import { createStructuredData, resolveSEO, type SEOProps } from "../config/seo";

const {
    pType = "website", // "article" or "website"
    pTitle = "", // meta title content
    pDescription = "", // meta description content
    pPath = "", // use in creating canonical URL
    pKeywords = [], // additional keywords
    pImagePath = "", // path to image relative to site root
    pTags = [], // additional tags for keywords from articles/projects
    pSlug = "", // slug for articles/projects used in creating canonical URL except for pages
    pPublishedTime = "", // for articles/projects
    pModifiedTime = "", // for articles/projects
    isIndexable = true, // whether the page should be indexable by search engines
} = Astro.props;

interface Props extends SEOProps {}

/// META TAG VALUES COMPUTATION

const resolved = resolveSEO({
    pType,
    pTitle,
    pDescription,
    pPath,
    pKeywords,
    pImagePath,
    pTags,
    pSlug,
    pPublishedTime,
    pModifiedTime,
    isIndexable,
});

const { metaType, isArticle, metaTitle, metaDescription, metaURL, metaKeywords, metaImage, metaImageMimeType, indexable } =
    resolved;

/// STRUCTURED DATA GENERATION

const structuredData = createStructuredData(
    {
        pType,
        pTitle,
        pDescription,
        pPath,
        pImagePath,
        pPublishedTime,
        pModifiedTime,
    },
    resolved,
);
---

<head>
    <!-- BASIC META -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>
        {metaTitle}
    </title>

    <meta name="description" content={metaDescription} />

    <meta name="author" content={SITE.fullName} />
    <link rel="canonical" href={metaURL} />
    <link rel="alternate" hreflang={SITE.locale} href={metaURL} />
    <link rel="alternate" hreflang="x-default" href={metaURL} />
    <link rel="sitemap" type="application/xml" href={`${SITE.url}/sitemap-index.xml`} />
    <meta name="keywords" content={metaKeywords} />
    <meta name="language" content={SITE.locale} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="application-name" content={SITE.fullName} />
    <link rel="author" href={SITE.url} />

    <!-- INDEXING -->
    {
        indexable ? (
            <>
                <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
                <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
            </>
        ) : (
            <>
                <meta name="robots" content="noindex, nofollow" />
                <meta name="googlebot" content="noindex, nofollow" />
            </>
        )
    }

    {isArticle && pPublishedTime ? <meta property="article:published_time" content={pPublishedTime} /> : null}
    {isArticle && pModifiedTime ? <meta property="article:modified_time" content={pModifiedTime} /> : null}
    {isArticle && pTags?.length ? pTags.map((tag: string) => <meta property="article:tag" content={tag} />) : null}

    <!-- ICONS -->
    <link rel="icon" href={SITE.siteIcons.ico} sizes="any" />
    <link rel="icon" href={SITE.siteIcons.svg} type="image/svg+xml" />
    <link rel="icon" href={SITE.siteIcons.png} type="image/png" />
    <link rel="icon" href={SITE.siteIcons.png32x32} type="image/png" sizes="32x32" />
    <link rel="icon" href={SITE.siteIcons.png16x16} type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href={SITE.siteIcons.appleTouchIcon} />
    <link rel="android-chrome-icon" href={SITE.siteIcons.androidChromeIcon} />

    <!-- THEME -->
    <meta name="theme-color" content={SITE.themeColor} />

    <!-- OPEN GRAPH -->
    <meta property="og:type" content={metaType} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={metaURL} />
    <meta property="og:site_name" content={SITE.fullName} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image" content={metaImage} />
    <meta property="og:image:secure_url" content={metaImage} />
    <meta property="og:image:type" content={metaImageMimeType} />
    <meta property="og:image:alt" content={metaTitle} />
    <meta property="og:updated_time" content={pModifiedTime || pPublishedTime || ""} />

    <!-- TWITTER -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={metaImage} />
    <meta name="twitter:image:alt" content={metaTitle} />
    <meta name="twitter:site" content={`@${SITE.social.twitter.username}`} />
    <meta name="twitter:creator" content={`@${SITE.social.twitter.username}`} />

    <!-- MS BING WEBMASTER TOOLS -->
    <meta name="msvalidate.01" content="610C651DB73EFF7F083B1B670B2BE0F5" />

    <!-- HERE WE CAN ADD ADDITIONAL HEAD ELEMENTS THROUGH THE SLOT -->
    <slot />

    <!-- STRUCTURED DATA (ENTITY SEO) -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</head>
