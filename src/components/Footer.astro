---
import { SITE } from "../config/site";
---

<footer 
    class="relative
    bg-black/70
    backdrop-blur-md
    border-t border-white/10"
>

    <!-- subtle top glow line -->
    <div 
        class="absolute inset-x-0 top-0 h-px
        bg-linear-to-r
        from-transparent
        via-cyan-400/40
        to-transparent"
    >
    </div>

    <div
        class="max-w-7xl mx-auto
        px-4 sm:px-6 lg:px-8
        py-14
        grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3
        gap-12
        text-sm text-white/70"
    >

        <!-- Brand -->
        <div class="text-center sm:text-left space-y-3">
            <p class="text-lg font-semibold neon-text">
                {SITE.fullName}
            </p>

            <p class="text-xs text-white/50">
                {SITE.role}
            </p>

            <p class="text-xs text-white/50 max-w-xs mx-auto sm:mx-0">
                {SITE.tagline}
            </p>
        </div>

        <!-- Navigation -->
        <div class="text-center">
            <p class="text-white font-semibold mb-5 tracking-wide">Navigation</p>

            <ul class="space-y-3">
                <li><a href="#home" class="hover:text-cyan-400 transition">Home</a></li>
                <li><a href="#about" class="hover:text-cyan-400 transition">About</a></li>
                <li><a href="#skills" class="hover:text-cyan-400 transition">Skills</a></li>
                <li><a href="/projects" class="hover:text-cyan-400 transition">Projects</a></li>
                <li><a href="/blog" class="hover:text-cyan-400 transition">Blog</a></li>
                <li><a href="#contact" class="hover:text-cyan-400 transition">Contact</a></li>
            </ul>
        </div>

        <!-- Connect -->
        <div class="text-center sm:text-right space-y-5">
            <p class="text-white font-semibold tracking-wide">Connect</p>

            <!-- social links -->
            <div class="flex justify-center sm:justify-end gap-6">
                <a href={SITE.social.github} class="hover:text-cyan-400 transition">GitHub</a>
                <a href={SITE.social.linkedin} class="hover:text-cyan-400 transition">LinkedIn</a>
                <a href={SITE.social.twitter} class="hover:text-cyan-400 transition">Twitter</a>
                <a href={SITE.social.instagram} class="hover:text-cyan-400 transition">Instagram</a>
            </div>

            <!-- divider -->
            <div class="hidden sm:block h-px w-24 ml-auto bg-white/10"></div>

            <!-- email -->
            <a
                href={SITE.social.mail}
                class="inline-block
                text-xs
                text-white/50
                hover:text-cyan-400
                transition"
            >
                contact@krsahil.co.in
            </a>
        </div>
    </div>

    <!-- bottom bar -->
    <div 
        class="border-t border-white/10
        py-4
        text-center
        text-xs text-white/40"
    >
        <p class="mt-2">Thank you for visiting</p>
        <p class="mt-2">
            Copyright &copy; {new Date().getFullYear()}
            {SITE.name}. All rights reserved.
        </p>
    </div>
</footer>
