---
import { IDENTITY, PROFESSION } from "../config/site-config";
import { LINKS } from "../config/social-config";
---

<footer class="relative bg-black/70 backdrop-blur-md border-t border-white/10">
    <!-- subtle top glow line -->
    <div class="absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-cyan-400/40 to-transparent"></div>

    <!-- Main content -->
    <div
        class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14 flex flex-col md:flex-row items-center md:items-start justify-between gap-12 text-sm text-white/70"
    >
        <!-- Brand -->
        <div class="text-center md:text-left space-y-3 max-w-sm">
            <p class="text-lg font-semibold neon-text">
                {IDENTITY.name}
            </p>

            <p class="text-xs text-white/50">
                {PROFESSION.title}
            </p>

            <p class="text-xs text-white/50">
                {PROFESSION.tagline}
            </p>
        </div>

        <!-- Connect -->
        <div class="text-center md:text-right space-y-5">
            <p class="text-white font-semibold tracking-wide">Connect</p>

            <!-- social links -->
            <div class="flex flex-wrap justify-center md:justify-end gap-6">
                <a href={LINKS.github} class="hover:text-cyan-400 transition">GitHub</a>
                <a href={LINKS.linkedin} class="hover:text-cyan-400 transition">LinkedIn</a>
                <a href={LINKS.twitter} class="hover:text-cyan-400 transition">Twitter</a>
                <a href={LINKS.instagram} class="hover:text-cyan-400 transition">Instagram</a>
            </div>

            <!-- divider -->
            <div class="hidden md:block h-px w-24 ml-auto bg-white/10"></div>

            <!-- email -->
            <a href={LINKS.email} class="inline-block text-xs text-white/50 hover:text-cyan-400 transition">
                {LINKS.email}
            </a>
        </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10 py-5 text-center text-xs text-white/40">
        <p>Thank you for visiting</p>
        <p class="mt-1">
            Copyright &copy; {new Date().getFullYear()}
            {IDENTITY.name} | All rights reserved.
        </p>
    </div>
</footer>
