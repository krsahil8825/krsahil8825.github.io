---
import MainLayout from "../../../layouts/MainLayout.astro";
import SEO from "../../../components/SEO.astro";

import NeonGradientBackground from "../../../features/blogs/PageComponent/NeonGradientBackground.astro";
import BlogHeader from "../../../features/blogs/PageComponent/BlogHeader.astro";
import BlogGrid from "../../../features/blogs/PageComponent/BlogGrid.astro";
import BlogPagination from "../../../features/blogs/PageComponent/BlogPagination.astro";

import { getBlogsListingStaticPaths } from "../../../utils/content-paths";
import { getBlogsListingSEO } from "../../../utils/page-seo";

// STATIC PATHS
export async function getStaticPaths() {
    return getBlogsListingStaticPaths();
}

/* PROPS */
const { page, totalPages, posts } = Astro.props;

/* SEO CONSTANTS */
const seo = getBlogsListingSEO(page);
---

<MainLayout>
    <!-- HEAD -->
    <Fragment slot="head">
        <SEO
            pType={seo.pType}
            pTitle={seo.pTitle}
            pDescription={seo.pDescription}
            pPath={seo.pPath}
            pKeywords={seo.pKeywords}
            pImagePath={seo.pImagePath}
            pTags={seo.pTags}
            pSlug={seo.pSlug}
            pPublishedTime={seo.pPublishedTime}
            pModifiedTime={seo.pModifiedTime}
            isIndexable={seo.isIndexable}
        />
    </Fragment>

    <!-- MAIN -->
    <Fragment slot="main">
        <section id="blogs" class="relative px-3 sm:px-6 lg:px-8 pt-11 sm:pt-15 pb-20 overflow-hidden">
            <NeonGradientBackground />
            <BlogHeader />
            <BlogGrid posts={posts} />
            <BlogPagination page={page} totalPages={totalPages} />
        </section>
    </Fragment>
</MainLayout>
