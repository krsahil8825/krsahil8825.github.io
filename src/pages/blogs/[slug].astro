---
import MainLayout from "../../layouts/MainLayout.astro";
import "../../styles/markdown.css";

import SEO from "../../components/SEO.astro";
import BlogArticle from "../../features/blogs/SlugComponent/BlogArticle.astro";

import type { CollectionEntry } from "astro:content";
import { getAdjacentSlugs } from "../../config/content";
import { getBlogSlugStaticPaths } from "../../config/page-paths";
import { getBlogArticleSEO } from "../../config/page-seo";

export async function getStaticPaths() {
    return getBlogSlugStaticPaths();
}

interface BlogSlugPageProps {
    blog: CollectionEntry<"blogs">;
    index: number;
    total: number;
    slugs: string[];
}

const { blog, index, total, slugs } = Astro.props as unknown as BlogSlugPageProps;

const { prevSlug, nextSlug } = getAdjacentSlugs(index, total, slugs);

const { Content } = await blog.render();

// SEO
const seo = getBlogArticleSEO(blog);
---

<MainLayout>
    <Fragment slot="head">
        <SEO
            pType={seo.pType}
            pTitle={seo.pTitle}
            pDescription={seo.pDescription}
            pPath={seo.pPath}
            pKeywords={seo.pKeywords}
            pImagePath={seo.pImagePath}
            pTags={seo.pTags}
            pSlug={seo.pSlug}
            pPublishedTime={seo.pPublishedTime}
            pModifiedTime={seo.pModifiedTime}
            isIndexable={seo.isIndexable}
        />
    </Fragment>

    <Fragment slot="main">
        <BlogArticle blog={blog} Content={Content} prevSlug={prevSlug} nextSlug={nextSlug} />
    </Fragment>
</MainLayout>
