---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import SEO from '../../components/SEO.astro';

const pType = "website";
const pTitle = "Projects";
const pDescription = "Explore My Projects - A showcase of my web development and programming endeavors, highlighting my skills and creativity. Discover a variety of projects that demonstrate my expertise in building innovative and functional applications.";
const pPath = "projects";
const pKeywords = ["projects", "portfolio", "krsahil projects", "sahil projects", "krsahil8825 projects", "webdevelopment projects"];
const pImagePath = "/site/projects-hero.png";
const pTags = [];
const pSlug = "";
const pPublishedTime = "";
const pModifiedTime = "";
const isIndexable = true;
---

<ArticleLayout>

    <!-- HEAD SLOT -->
    <Fragment slot="head">
        <SEO
            pType={pType}
            pTitle={pTitle}
            pDescription={pDescription}
            pPath={pPath}
            pKeywords={pKeywords}
            pImagePath={pImagePath}
            pTags={pTags}
            pSlug={pSlug}
            pPublishedTime={pPublishedTime}
            pModifiedTime={pModifiedTime}
            isIndexable={isIndexable}
        />
    </Fragment>

    <!-- MAIN SLOT -->
    <Fragment slot="main">
        <h1 class="text-4xl font-bold text-center mt-20">Coming Soon</h1>
    </Fragment>

</ArticleLayout>
