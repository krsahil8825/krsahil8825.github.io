---
import MainLayout from "../../layouts/MainLayout.astro";
import SEO from "../../components/SEO.astro";

import NeonGradientBackground from "../../features/projects/NeonGradientBackground.astro";
import ProjectHeader from "../../features/projects/ProjectHeader.astro";
import ProjectsGrid from "../../features/projects/ProjectsGrid.astro";

// DATA FETCHING
import { getCollection } from "astro:content";
const posts = await getCollection("projects");

// SEO CONSTANTS
const pType = "website";
const pTitle = "Projects";
const pDescription =
    "Explore My Projects - A showcase of my web development and programming endeavors, highlighting my skills and creativity. Discover a variety of projects that demonstrate my expertise in building innovative and functional applications.";
const pPath = "projects";
const pKeywords = [
    "projects",
    "portfolio",
    "krsahil projects",
    "sahil projects",
    "krsahil8825 projects",
    "webdevelopment projects",
];
const pImagePath = "/site/projects-hero.png";
const pTags: string[] = [];
const pSlug = "";
const pPublishedTime = "";
const pModifiedTime = "";
const isIndexable = true;
---

<MainLayout>
    <!-- HEAD -->
    <Fragment slot="head">
        <SEO
            pType={pType}
            pTitle={pTitle}
            pDescription={pDescription}
            pPath={pPath}
            pKeywords={pKeywords}
            pImagePath={pImagePath}
            pTags={pTags}
            pSlug={pSlug}
            pPublishedTime={pPublishedTime}
            pModifiedTime={pModifiedTime}
            isIndexable={isIndexable}
        />
    </Fragment>

    <!-- MAIN -->
    <Fragment slot="main">
        <section id="projects" class="relative px-3 sm:px-6 lg:px-8 pt-28 sm:pt-32 pb-20 overflow-hidden">
            <NeonGradientBackground />
            <ProjectHeader />
            <ProjectsGrid posts={posts} />
        </section>
    </Fragment>
</MainLayout>
