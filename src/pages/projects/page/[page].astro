---
import MainLayout from "../../../layouts/MainLayout.astro";
import SEO from "../../../components/SEO.astro";

import NeonGradientBackground from "../../../features/projects/PageComponent/NeonGradientBackground.astro";
import ProjectHeader from "../../../features/projects/PageComponent/ProjectHeader.astro";
import ProjectsGrid from "../../../features/projects/PageComponent/ProjectsGrid.astro";
import ProjectsPagination from "../../../features/projects/PageComponent/ProjectsPagination.astro";

import { getCollection } from "astro:content";

// STATIC PATHS
export async function getStaticPaths() {
    // PAGINATION CONFIG
    const MAX_ITEMS = 6;

    const projects = await getCollection("projects");

    // Optional: newest first
    projects.sort((a, b) => new Date(b.data.publishedTime).getTime() - new Date(a.data.publishedTime).getTime());

    const totalPages = Math.ceil(projects.length / MAX_ITEMS);

    return Array.from({ length: totalPages }, (_, i) => {
        const page = i + 1;

        return {
            params: { page: String(page) },
            props: {
                page,
                totalPages,
                posts: projects.slice(i * MAX_ITEMS, i * MAX_ITEMS + MAX_ITEMS),
            },
        };
    });
}

/* PROPS */
const { page, totalPages, posts } = Astro.props;

/* SEO CONSTANTS */
const pType = "website";
const pTitle = `Projects - Page ${page}`;
const pDescription = "Explore My Projects - A showcase of backend, system design, and production-quality work.";
const pPath = `projects/page/${page}`;
const pKeywords = ["projects", "portfolio", "backend projects", "web development"];
const pImagePath = "/site/projects-hero.png";
const pTags: string[] = [];
const pSlug = "";
const pPublishedTime = "";
const pModifiedTime = "";
const isIndexable = true;
---

<MainLayout>
    <!-- HEAD -->
    <Fragment slot="head">
        <SEO
            pType={pType}
            pTitle={pTitle}
            pDescription={pDescription}
            pPath={pPath}
            pKeywords={pKeywords}
            pImagePath={pImagePath}
            pTags={pTags}
            pSlug={pSlug}
            pPublishedTime={pPublishedTime}
            pModifiedTime={pModifiedTime}
            isIndexable={isIndexable}
        />
    </Fragment>

    <!-- MAIN -->
    <Fragment slot="main">
        <section id="projects" class="relative px-3 sm:px-6 lg:px-8 pt-11 sm:pt-15 pb-20 overflow-hidden">
            <NeonGradientBackground />
            <ProjectHeader />
            <ProjectsGrid posts={posts} />
            <ProjectsPagination page={page} totalPages={totalPages} />
        </section>
    </Fragment>
</MainLayout>
