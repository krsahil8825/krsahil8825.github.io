---
import MainLayout from "../../../layouts/MainLayout.astro";
import SEO from "../../../components/SEO.astro";

import NeonGradientBackground from "../../../features/projects/PageComponent/NeonGradientBackground.astro";
import ProjectHeader from "../../../features/projects/PageComponent/ProjectHeader.astro";
import ProjectsGrid from "../../../features/projects/PageComponent/ProjectsGrid.astro";
import ProjectsPagination from "../../../features/projects/PageComponent/ProjectsPagination.astro";

import { getProjectsListingStaticPaths } from "../../../config/page-paths";
import { getProjectsListingSEO } from "../../../config/page-seo";

// STATIC PATHS
export async function getStaticPaths() {
    return getProjectsListingStaticPaths();
}

/* PROPS */
const { page, totalPages, posts } = Astro.props;

/* SEO CONSTANTS */
const seo = getProjectsListingSEO(page);
---

<MainLayout>
    <!-- HEAD -->
    <Fragment slot="head">
        <SEO
            pType={seo.pType}
            pTitle={seo.pTitle}
            pDescription={seo.pDescription}
            pPath={seo.pPath}
            pKeywords={seo.pKeywords}
            pImagePath={seo.pImagePath}
            pTags={seo.pTags}
            pSlug={seo.pSlug}
            pPublishedTime={seo.pPublishedTime}
            pModifiedTime={seo.pModifiedTime}
            isIndexable={seo.isIndexable}
        />
    </Fragment>

    <!-- MAIN -->
    <Fragment slot="main">
        <section id="projects" class="relative px-3 sm:px-6 lg:px-8 pt-11 sm:pt-15 pb-20 overflow-hidden">
            <NeonGradientBackground />
            <ProjectHeader />
            <ProjectsGrid posts={posts} />
            <ProjectsPagination page={page} totalPages={totalPages} />
        </section>
    </Fragment>
</MainLayout>
