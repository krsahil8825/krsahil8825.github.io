---
import MainLayout from "../../layouts/MainLayout.astro";
import "../../styles/markdown.css";

import SEO from "../../components/SEO.astro";
import ProjectArticle from "../../features/projects/SlugComponent/ProjectArticle.astro";

import type { CollectionEntry } from "astro:content";
import { getAdjacentSlugs } from "../../config/content";
import { getProjectSlugStaticPaths } from "../../config/page-paths";
import { getProjectArticleSEO } from "../../config/page-seo";

export async function getStaticPaths() {
    return getProjectSlugStaticPaths();
}

interface ProjectSlugPageProps {
    project: CollectionEntry<"projects">;
    index: number;
    total: number;
    slugs: string[];
}

const { project, index, total, slugs } = Astro.props as unknown as ProjectSlugPageProps;

const { prevSlug, nextSlug } = getAdjacentSlugs(index, total, slugs);

const { Content } = await project.render();

// SEO
const seo = getProjectArticleSEO(project);
---

<MainLayout>
    <Fragment slot="head">
        <SEO
            pType={seo.pType}
            pTitle={seo.pTitle}
            pDescription={seo.pDescription}
            pPath={seo.pPath}
            pKeywords={seo.pKeywords}
            pImagePath={seo.pImagePath}
            pTags={seo.pTags}
            pSlug={seo.pSlug}
            pPublishedTime={seo.pPublishedTime}
            pModifiedTime={seo.pModifiedTime}
            isIndexable={seo.isIndexable}
        />
    </Fragment>

    <Fragment slot="main">
        <ProjectArticle project={project} Content={Content} prevSlug={prevSlug} nextSlug={nextSlug} />
    </Fragment>
</MainLayout>
