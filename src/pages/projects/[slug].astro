---
import MainLayout from "../../layouts/MainLayout.astro";
import "../../styles/markdown.css";

import SEO from "../../components/SEO.astro";
import ProjectArticle from "../../features/projects/SlugComponent/ProjectArticle.astro";

import { getCollection } from "astro:content";

export async function getStaticPaths() {
    const projects = await getCollection("projects");

    projects.sort((a, b) => new Date(b.data.publishedTime).getTime() - new Date(a.data.publishedTime).getTime());

    return projects.map((project, index) => ({
        params: { slug: project.slug },
        props: {
            project,
            index,
            total: projects.length,
            slugs: projects.map((p) => p.slug),
        },
    }));
}

const { project, index, total, slugs } = Astro.props;

const prevSlug = index > 0 ? slugs[index - 1] : null;
const nextSlug = index < total - 1 ? slugs[index + 1] : null;

const { Content } = await project.render();

// SEO
const pType = "article";
const pTitle = project.data.title;
const pDescription = project.data.description;
const pPath = "projects";
const pKeywords = project.data.keywords;
const pImagePath = project.data.imagePath;
const pTags = project.data.tags;
const pSlug = project.slug;
const pPublishedTime = project.data.publishedTime;
const pModifiedTime = project.data.modifiedTime ?? "";
const isIndexable = true;
---

<MainLayout>
    <Fragment slot="head">
        <SEO
            pType={pType}
            pTitle={pTitle}
            pDescription={pDescription}
            pPath={pPath}
            pKeywords={pKeywords}
            pImagePath={pImagePath}
            pTags={pTags}
            pSlug={pSlug}
            pPublishedTime={pPublishedTime}
            pModifiedTime={pModifiedTime}
            isIndexable={isIndexable}
        />
    </Fragment>

    <Fragment slot="main">
        <ProjectArticle project={project} Content={Content} prevSlug={prevSlug} nextSlug={nextSlug} />
    </Fragment>
</MainLayout>
