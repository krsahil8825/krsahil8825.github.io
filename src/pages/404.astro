---
import BaseLayout from "../layouts/BaseLayout.astro";

const NOT_FOUND_IMAGE = "/site/404.svg";
---

<BaseLayout>
    <section
        aria-label="404 page not found"
        class="relative
        min-h-screen
        flex items-start
        pt-32 sm:pt-36 lg:pt-40
        pb-8
        px-4 sm:px-6 lg:px-8
        overflow-hidden"
    >
    
        <!-- Neon gradient background -->
        <div
            class="absolute inset-0 -z-10
            bg-linear-to-br
            from-cyan-500/15
            via-transparent
            to-purple-500/15"
        >
        </div>

        <div 
            class="max-w-3xl mx-auto w-full
            flex flex-col items-center
            text-center"
        >
            <!-- IMAGE -->
            <div class="relative mb-10">
                <!-- Glow -->
                <div
                    class="absolute inset-0
                    rounded-full
                    bg-cyan-400/25
                    blur-3xl
                    scale-110"
                >
                </div>

                <img
                    src={NOT_FOUND_IMAGE}
                    alt="404 Page Not Found"
                    loading="eager"
                    decoding="async"
                    class="relative
                    w-full
                    object-contain
                    drop-shadow-[0_0_40px_rgba(34,211,238,0.25)]"
                />
            </div>

            <!-- TEXT -->
            <p class="text-sm
                uppercase
                tracking-widest
                text-cyan-400
                font-semibold"
            >
                Error 404
            </p>

            <h1
                class="mt-3
                text-4xl sm:text-5xl md:text-6xl
                font-extrabold
                leading-tight
                neon-text"
            >
                Page Not Found
            </h1>

            <p
                class="mt-6
                max-w-xl
                text-sm sm:text-base md:text-lg
                text-gray-400
                leading-relaxed"
            >
                The page you're looking for doesn't exist or may have been moved. Don't worry - you can safely return to the
                homepage.
            </p>

            <!-- CTA -->
            <div class="mt-12">
                <a
                    href="/"
                    class="inline-flex items-center justify-center
                    h-12 min-w-44
                    px-10
                    rounded-lg
                    font-semibold
                    text-cyan-300
                    bg-cyan-500/10
                    border border-cyan-400/40
                    transition-all duration-300
                    hover:bg-cyan-500/20
                    hover:text-cyan-200
                    hover:shadow-[0_0_24px_rgba(34,211,238,0.45)]"
                >
                    Go Back Home
                </a>
            </div>
        </div>
    </section>
</BaseLayout>
