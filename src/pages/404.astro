---
import MainLayout from "../layouts/MainLayout.astro";
import SEO from "../components/SEO.astro";

import BackgroundGlow from "../features/404/BackgroundGlow.astro";
import ErrorIllustration from "../features/404/ErrorIllustration.astro";
import ErrorText from "../features/404/ErrorText.astro";
import BackHomeButton from "../features/404/BackHomeButton.astro";
import { createNotFoundSEO } from "../config/seo";

const NOT_FOUND_IMAGE = "/site/404.svg";

const seo = createNotFoundSEO();
---

<MainLayout>
    <!-- HEAD -->
    <Fragment slot="head">
        <SEO
            pType={seo.pType}
            pTitle={seo.pTitle}
            pDescription={seo.pDescription}
            pPath={seo.pPath}
            pKeywords={seo.pKeywords}
            pImagePath={seo.pImagePath}
            pTags={seo.pTags}
            pSlug={seo.pSlug}
            pPublishedTime={seo.pPublishedTime}
            pModifiedTime={seo.pModifiedTime}
            isIndexable={seo.isIndexable}
        />
    </Fragment>

    <!-- MAIN -->
    <Fragment slot="main">
        <section
            aria-label="404 page not found"
            class="relative min-h-screen flex items-start pt-15 sm:pt-19 lg:pt-23 pb-8 px-4 sm:px-6 lg:px-8 overflow-hidden"
        >
            <BackgroundGlow />

            <div class="max-w-3xl mx-auto w-full flex flex-col items-center text-center">
                <ErrorIllustration image={NOT_FOUND_IMAGE} />
                <ErrorText />
                <BackHomeButton />
            </div>
        </section>
    </Fragment>
</MainLayout>
