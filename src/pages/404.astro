---
import MainLayout from "../layouts/MainLayout.astro";
import SEO from "../components/SEO.astro";

import BackgroundGlow from "../features/404/BackgroundGlow.astro";
import ErrorIllustration from "../features/404/ErrorIllustration.astro";
import ErrorText from "../features/404/ErrorText.astro";
import BackHomeButton from "../features/404/BackHomeButton.astro";

const NOT_FOUND_IMAGE = "/site/404.svg";

// SEO CONSTANTS
const pType = "website";
const pTitle = "404 - Page Not Found";
const pDescription = "Oops! The page you're looking for doesn't exist. Return to the homepage and explore our content.";
const pPath = "404";
const pKeywords = ["404", "page not found", "error", "krsahil 404", "sahil 404"];
const pImagePath = "/site/404-hero.png";
const pTags: string[] = [];
const pSlug = "";
const pPublishedTime = "";
const pModifiedTime = "";
const isIndexable = false;
---

<MainLayout>
    <!-- HEAD -->
    <Fragment slot="head">
        <SEO
            pType={pType}
            pTitle={pTitle}
            pDescription={pDescription}
            pPath={pPath}
            pKeywords={pKeywords}
            pImagePath={pImagePath}
            pTags={pTags}
            pSlug={pSlug}
            pPublishedTime={pPublishedTime}
            pModifiedTime={pModifiedTime}
            isIndexable={isIndexable}
        />
    </Fragment>

    <!-- MAIN -->
    <Fragment slot="main">
        <section
            aria-label="404 page not found"
            class="relative min-h-screen flex items-start pt-32 sm:pt-36 lg:pt-40 pb-8 px-4 sm:px-6 lg:px-8 overflow-hidden"
        >
            <BackgroundGlow />

            <div class="max-w-3xl mx-auto w-full flex flex-col items-center text-center">
                <ErrorIllustration image={NOT_FOUND_IMAGE} />
                <ErrorText />
                <BackHomeButton />
            </div>
        </section>
    </Fragment>
</MainLayout>
