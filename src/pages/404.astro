---
import MainLayout from "../layouts/MainLayout.astro";
import SEO from "../components/SEO.astro";

import BackgroundGlow from "../features/404/BackgroundGlow.astro";
import ErrorIllustration from "../features/404/ErrorIllustration.astro";
import ErrorText from "../features/404/ErrorText.astro";
import BackHomeButton from "../features/404/BackHomeButton.astro";

const NOT_FOUND_IMAGE = "/site/404.svg";
---

<MainLayout>
    <Fragment slot="head">
        <SEO
            pType="website"
            pTitle="404 - Page Not Found"
            pDescription="Oops! The page you're looking for doesn't exist. Return to the homepage and explore our content."
            pPath="404"
            pKeywords={["404", "page not found", "error", "krsahil 404", "sahil 404"]}
            pImagePath="/site/404-hero.png"
            pTags={[]}
            pSlug=""
            pPublishedTime=""
            pModifiedTime=""
            isIndexable={false}
        />
    </Fragment>
    <Fragment slot="main">
        <section
            aria-label="404 page not found"
            class="relative min-h-screen flex items-start pt-32 sm:pt-36 lg:pt-40 pb-8 px-4 sm:px-6 lg:px-8 overflow-hidden"
        >
            <BackgroundGlow />

            <div class="max-w-3xl mx-auto w-full flex flex-col items-center text-center">
                <ErrorIllustration image={NOT_FOUND_IMAGE} />
                <ErrorText />
                <BackHomeButton />
            </div>
        </section>
    </Fragment>
</MainLayout>
