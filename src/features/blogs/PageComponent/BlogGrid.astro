---
import BlogCard from "./BlogCard.astro";

const { posts } = Astro.props;
---

{
    posts.length === 0 ? (
        <p class="text-center text-gray-400 text-sm sm:text-base">No projects found.</p>
    ) : (
        <div class="max-w-7xl mx-auto grid grid-cols-1 px-5 min-[540px]:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
            {posts.map((post: any) => (
                <BlogCard
                    slug={post.slug}
                    title={post.data.title}
                    description={post.data.description}
                    imagePath={post.data.imagePath}
                />
            ))}
        </div>
    )
}
