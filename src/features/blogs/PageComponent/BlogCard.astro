---
interface Props {
    slug: string;
    title: string;
    description: string;
    imagePath: string;
}

const { slug, title, description, imagePath } = Astro.props;
---

<a
    href={`/blogs/${slug}`}
    class="group
        relative
        flex flex-col
        h-full
        rounded-xl
        border border-cyan-400/25
        bg-cyan-500/5
        backdrop-blur-sm
        p-4 sm:p-5
        transition-all duration-300
        hover:bg-cyan-500/5
        hover:border-cyan-400/50
        hover:shadow-[0_0_30px_rgba(34,211,238,0.1)]"
>
    <!-- Card glow -->
    <div
        class="absolute inset-0
        rounded-xl
        opacity-0
        group-hover:opacity-100
        transition-opacity
        bg-cyan-400/10
        blur-2xl
        -z-10"
    >
    </div>

    <!-- IMAGE (16:9) -->
    <div
        class="relative
            w-full
            aspect-video
            rounded-lg
            overflow-hidden
            border
            border-cyan-400/30
            bg-black/20
            mb-4"
    >
        <img
            src={imagePath}
            alt={title}
            loading="lazy"
            decoding="async"
            class="w-full h-full
                object-cover
                transition-transform duration-300
                group-hover:scale-[1.03]"
        />
    </div>

    <!-- Title -->
    <h2 class="text-base sm:text-lg
            font-semibold
            text-cyan-300
            leading-snug
            mb-2">
        {title}
    </h2>

    <!-- Description -->
    <p class="text-sm sm:text-base
            text-gray-400
            leading-relaxed
            grow">
        {description}
    </p>

    <!-- CTA -->
    <span
        class="mt-5
            inline-flex
            items-center
            cursor-pointer
            border border-purple-300
            group-hover:border-purple-200
            w-fit
            px-3 py-1
            rounded-md
            bg-purple-400/10
            text-sm
            font-medium
            text-purple-300
            group-hover:text-purple-200
            transition-colors"
    >
        Read Article →
    </span>
</a>
