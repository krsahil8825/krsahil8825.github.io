---
const { blog } = Astro.props;
---

<div class="mt-4">
    <div class="text-sm text-gray-400 flex gap-6">
        <span>Published: {blog.data.publishedTime}</span>
        {blog.data.modifiedTime && <span>Updated: {blog.data.modifiedTime}</span>}
    </div>

    <div class="mt-4 flex flex-wrap gap-2">
        {
                blog.data.tags.map((tag: string) => (
                <span class="px-3 py-1 text-xs rounded-full border border-purple-400/40 text-purple-300 bg-purple-500/10">
                    {tag}
                </span>
            ))
        }
    </div>
</div>
