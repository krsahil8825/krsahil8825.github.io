---
import BlogHero from "./BlogHero.astro";
import BlogMeta from "./BlogMeta.astro";
import BlogDescription from "./BlogDescription.astro";
import BlogContent from "./BlogContent.astro";
import BlogNavigation from "./BlogNavigation.astro";

const { blog, Content, prevSlug, nextSlug } = Astro.props;
---

<article class="relative px-3 sm:px-6 lg:px-8 pt-11 sm:pt-15 pb-24 overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-linear-to-br from-cyan-500/10 via-transparent to-purple-500/10"></div>

    <div class="max-w-4xl mx-auto">
        <BlogHero blog={blog} />
        <BlogMeta blog={blog} />
        <BlogDescription description={blog.data.description} />
        <BlogContent>
            <Content />
        </BlogContent>
        <BlogNavigation prevSlug={prevSlug} nextSlug={nextSlug} />
    </div>
</article>
