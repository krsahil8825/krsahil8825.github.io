---
import { ROUTES } from "../../../config/routes-config";

interface Props {
    prevSlug: string | null;
    nextSlug: string | null;
}

const { prevSlug, nextSlug } = Astro.props as Props;
---

<div class="w-full flex flex-col items-center justify-center border-t border-purple-400/20 pt-10 mb-10">
    {
        prevSlug || nextSlug ? (
            <p class="text-sm sm:text-base text-gray-400 text-center max-w-xl mx-auto mb-4">
                Browse other blog posts. This is the end of the article.
            </p>
        ) : null
    }
    <nav class="mt-6 flex gap-6 w-full align-middle justify-between px-5">
        {
            prevSlug ? (
                <a
                    href={`${ROUTES.blogs.slugBase}/${prevSlug}`}
                    class="nav-prev px-5 py-2 rounded-lg border border-cyan-400/40 text-cyan-300 bg-cyan-500/10 hover:bg-cyan-500/20 transition-all"
                >
                    &#8249;
                </a>
            ) : (
                <div class="flex-1" />
            )
        }

        {
            nextSlug ? (
                <a
                    href={`${ROUTES.blogs.slugBase}/${nextSlug}`}
                    class="nav-next px-5 py-2 rounded-lg border border-purple-400/40 text-purple-300 bg-purple-500/10 hover:bg-purple-500/20 transition-all"
                >
                    &#8250;
                </a>
            ) : (
                <div class="flex-1" />
            )
        }
    </nav>
</div>
