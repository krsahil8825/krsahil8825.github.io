---
const { project } = Astro.props;
---

<div class="mt-8 flex flex-wrap gap-4">
    {
        project.data.githubURL && (
            <a href={project.data.githubURL} target="_blank" class="border border-cyan-500/50 bg-cyan-500/10 hover:border-cyan-500/70 px-3 py-2 rounded-md text-cyan-400 hover:text-cyan-300 transition-colors duration-200">
                View on GitHub
            </a>
        )
    }
    {
        project.data.projectVideoURL && (
            <a href={project.data.projectVideoURL} target="_blank" class="border border-yellow-500/50 bg-yellow-500/10 hover:border-yellow-500/70 px-3 py-2 rounded-md text-yellow-400 hover:text-yellow-300 transition-colors duration-200">
                Watch Demo
            </a>
        )
    }
    {
        project.data.projectURL && (
            <a href={project.data.projectURL} target="_blank" class="border border-purple-500/50 bg-purple-500/10 hover:border-purple-500/70 px-3 py-2 rounded-md text-purple-400 hover:text-purple-300 transition-colors duration-200">
                Live Project
            </a>
        )
    }
</div>
