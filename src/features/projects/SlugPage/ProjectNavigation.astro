---
const { prevSlug, nextSlug } = Astro.props;
---

<nav class="mt-20 flex gap-6">
    {
        prevSlug ? (
            <a
                href={`/projects/${prevSlug}`}
                class="nav-prev px-3 py-2 border-2 border-purple-400/20 rounded-2xl hover:border-purple-400/40 hover:bg-blue-600/20 transition"
            >
                ← Previous
            </a>
        ) : (
            <div class="flex-1" />
        )
    }

    {
        nextSlug ? (
            <a
                href={`/projects/${nextSlug}`}
                class="nav-next  px-3 py-2 border-2 border-purple-400/20 rounded-2xl hover:border-purple-400/40 hover:bg-blue-600/20 transition"
            >
                Next →
            </a>
        ) : (
            <div class="flex-1" />
        )
    }
</nav>
