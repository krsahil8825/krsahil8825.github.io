---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en" class="scroll-smooth scrollbar overflow-x-hidden">
    <slot name="head" />
    <body class="antialiased min-h-screen flex flex-col justify-between bg-white text-black dark:bg-black dark:text-white transition-colors duration-500" >
        <Navbar />
        <main class="mt-17">
            <slot name="main" />
        </main>
        <Footer />
    </body>
</html>
